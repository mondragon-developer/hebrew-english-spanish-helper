# Optional: improves the public MyMemory API quota attribution.
MYMEMORY_EMAIL=you@example.com
# Provider adapter selector. Only "mymemory" is currently implemented.
TRANSLATION_PROVIDER=mymemory
# Required only for microphone transcription. Create an Azure AI Speech F0 resource.
AZURE_SPEECH_KEY=replace-with-your-azure-speech-key
AZURE_SPEECH_REGION=replace-with-your-azure-region
